# warpd配置文件
# 新增sift模式：直接精确定位（1个字符）

# 重复移动事件的间隔（毫秒）
repeat_interval: 10

# ===== 全局激活键配置 =====
# Super+Alt+x → hint1（快速两字符定位）
hint_activation_key: A-M-x

# Super+Alt+z → hint2（两字符+第二阶段）
hint2_activation_key: A-M-z

# ===== Normal模式下的快捷键 =====
# x → hint1（快速定位）
hint: x

# z → sift（直接显示5×5网格，1个字符精确定位）
sift: z

# ===== Hint1配置（快速模式）=====
hint_chars: asdfghjklqwertyuiopzxcvbnm
hint_size: 15
hint_bgcolor: #1c1c1e
hint_fgcolor: #a1aba7
hint_border_radius: 3

# ===== Sift模式配置（直接精确定位）=====
# 5×5网格，25个精确点，只需1个字符！
hint2_chars: asdfgqwertzxcvhjkl;yuiopnm
hint2_grid_size: 5
hint2_size: 12
hint2_gap_size: 2
